{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitpass",
  "version": "0.6.2",
  "identifier": "dev.gitpass.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gitpass",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      },
      {
        "label": "quick-access",
        "title": "gitpass Quick Access",
        "url": "index.html?window=quick-access",
        "width": 560,
        "height": 380,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RjRBMkMwQUQyQUNDQzUKUldURnpDcXR3S0wwRm9vQkJGK2ZqN3pOWVhJaklMbGhTbGRvcllna0duNFM2N2JmMldGdUpIRjcK",
      "endpoints": [
        "https://github.com/itsd0/gitpass-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
