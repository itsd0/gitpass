{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main + quick-access windows: core defaults (+ hide for quick-access); all vault access goes through app commands",
  "windows": [
    "main",
    "quick-access"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
