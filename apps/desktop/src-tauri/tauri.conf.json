{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitpass",
  "version": "0.5.0",
  "identifier": "dev.gitpass.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gitpass",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      },
      {
        "label": "quick-access",
        "title": "gitpass Quick Access",
        "url": "index.html?window=quick-access",
        "width": 560,
        "height": 380,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}