<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Automatic sync is skipped while offline (#455). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Opt-in biometric unlock (#473): normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- QR device pairing (#458): runtime permission, frames are decoded on the device and never stored. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application
        android:name=".GitpassApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gitpass">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Gitpass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Password AutofillService (#475). Only the system can bind it. -->
        <service
            android:name=".autofill.GitpassAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
        <!-- Unlock steps for autofill; started only through the service's own PendingIntents. -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Gitpass" />
        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Gitpass" />
        <!--
          Passkey provider for Credential Manager (#477). Android 14+ only:
          below API 34 the bool is false, so the service and its activities
          do not exist for the system. Only the system can bind it.
        -->
        <service
            android:name=".passkey.GitpassCredentialProviderService"
            android:enabled="@bool/passkey_provider_enabled"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>
        <!-- Passkey steps; started only through the provider's own PendingIntents. -->
        <activity
            android:name=".passkey.PasskeyUnlockActivity"
            android:enabled="@bool/passkey_provider_enabled"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Gitpass" />
        <activity
            android:name=".passkey.PasskeyGetActivity"
            android:enabled="@bool/passkey_provider_enabled"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Gitpass" />
        <activity
            android:name=".passkey.PasskeyCreateActivity"
            android:enabled="@bool/passkey_provider_enabled"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Gitpass" />
    </application>

</manifest>
