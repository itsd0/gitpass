{
  "manifest_version": 3,
  "name": "gitpass",
  "version": "0.6.0",
  "version_name": "0.6.0",
  "description": "__MSG_extDesc__",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "lib/policy.js",
      "bg-page.js",
      "background.js",
      "bg-onboard.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "gitpass"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lib/policy.js",
        "lib/forms.js",
        "lib/i18n.js",
        "lib/icons.js",
        "content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gitpass@gitpass.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "default_locale": "en",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open gitpass"
    }
  }
}
