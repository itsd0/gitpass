{
  "manifest_version": 3,
  "name": "gitpass",
  "version": "0.6.3",
  "version_name": "0.6.3",
  "description": "__MSG_extDesc__",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "clipboardWrite",
    "storage",
    "scripting",
    "idle",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "gitpass"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lib/passkey-main.js"
      ],
      "world": "MAIN",
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lib/passkey-bridge.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lib/policy.js",
        "lib/forms.js",
        "lib/password-rules.js",
        "lib/i18n.js",
        "lib/icons.js",
        "lib/banner.js",
        "lib/totp-chip.js",
        "content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "default_locale": "en",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open gitpass"
    },
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_cmdFillLogin__"
    }
  }
}
